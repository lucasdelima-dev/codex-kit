#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
KIT="$(cd "$SCRIPT_DIR/.." && pwd)"

OS="$(uname -s)"
ARCH="$(uname -m)"

case "$ARCH" in
  x86_64|amd64)
    ARCH="x86_64"
    ;;
  arm64|aarch64)
    ARCH="aarch64"
    ;;
  *)
    echo "Arquitetura não suportada: $ARCH" >&2
    exit 2
    ;;
esac

case "$OS" in
  Linux)
    if grep -qi microsoft /proc/version 2>/dev/null ||
       grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
      export CODEX_PLATFORM="wsl"
    else
      export CODEX_PLATFORM="linux"
    fi

    export CODEX_ARCH="$ARCH"
    exec "$KIT/platform/linux/machine.sh"
    ;;

  Darwin)
    export CODEX_PLATFORM="macos"
    export CODEX_ARCH="$ARCH"
    exec "$KIT/platform/macos/machine.sh"
    ;;

  *)
    echo "Sistema não suportado pelo bootstrap Unix: $OS" >&2
    echo "No Windows nativo use bin/bootstrap-machine.ps1." >&2
    exit 2
    ;;
esac
